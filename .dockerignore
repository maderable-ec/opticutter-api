# Version control
.git
.gitignore

# Virtual environments
.venv
venv

# Python/test caches and artifacts
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
htmlcov
.coverage

# Rust build artifacts. `rust/` itself MUST reach the context (the rustbuild
# stage compiles the packing kernel from it), but target/ is huge and is
# rebuilt inside the image anyway.
rust/target

# Cost-regression baselines (scripts/bench_battery.py).
benchmarks

# Local data and secrets
*.db
.env

# Tests and documentation (not needed in the image)
tests
docs
*.md

# Local tooling configuration
.github
.claude
.mcp.json
.editorconfig
