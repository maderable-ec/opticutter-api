# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tests and coverage
.pytest_cache/
.ruff_cache/
.coverage
# One per optimizer worker process: coverage writes a per-process data file and
# combining it can be skipped when the pool is torn down mid-run.
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/

# Environment variables and local data
.env
*.db

# Order attachments (anexos) stored on local disk
uploads/

# Print job spool (rendered labels/PDFs pending pickup by a shop-floor agent)
print_spool/

# Real customer cut lists exported by the commercial optimizer, used as the
# parity benchmark by scripts/bench_shopfiles.py. Business data — kept local.
# scripts/bench_prod.py embeds the geometry it needs, so it runs without them.
pruebas/

# Editors and IDEs
*~
*.swp
.idea/
.qodo

# Local tools (not shared)
.claude/
.mcp.json

# Exceptions: these are versioned
!.gitignore
!.dockerignore
!.editorconfig
!.env.example
!.github/
