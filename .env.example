ENVIRONMENT=local
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000
REDIS_URL=redis://redis:6379/0
OPT_RESULT_TTL_SECONDS=259200
CORS_ORIGINS=http://localhost:3000

# Cutting engine budgets. All of these feed the optimization hash: change one
# and cached layouts are recomputed instead of served stale.
# The board-count search counts candidate fills, never seconds.
OPT_TRIES_PER_BOARD=48
OPT_SEARCH_ITERATIONS=40
# CP-SAT exact endgame: decides the last board exactly, where the heuristics
# measurably strand pieces. Budgeted in solver calls + OR-Tools "deterministic
# time" (a work unit, not wall clock) so results stay reproducible and cacheable.
# Set OPT_EXACT_ENABLED=false to fall back to the pure-heuristic search.
OPT_EXACT_ENABLED=true
OPT_EXACT_MAX_PIECES=120
OPT_EXACT_MAX_CALLS=40
# Budget of the entry that DECIDES ("does this tail close in one more board?").
# It terminates on a proof, so it is cheap and worth a generous allowance.
OPT_EXACT_DETERMINISTIC_TIME=6.0
# Budget of the entry that OPTIMIZES (the densest opening board). It never proves
# optimality on a real pool, so it spends every unit it is handed. 0.5 is 2.5x
# faster with identical bills on every real pool, at the price of one extra board
# per ~1159 on the randomized battery; 3.0 (with patience 6) is the setting that
# costs nothing anywhere (see ExactConfig in cutting/search.py).
OPT_EXACT_ROOT_DETERMINISTIC_TIME=0.5
# ...and it stops being consulted after this many LNS rounds in a row that
# improved nothing (0 = never seed from LNS; a big number = ask until the call
# budget runs out, the pre-ENGINE_VERSION-6 behavior).
OPT_EXACT_ROOT_PATIENCE=2

# Per-material parallelism. A request costs the SUM over its materials when this
# is 1 and the MAX when it is 2+, because the pools are independent. Unlike every
# knob above, these are NOT in the optimization hash: they change which process
# runs the computation, never the geometry it produces. 1 disables parallelism.
OPT_POOL_WORKERS=2
OPT_POOL_TIMEOUT_SECONDS=300
OPT_POOL_MAX_TASKS_PER_CHILD=4

# Packing kernel: auto (usa el wheel nativo si importó) | rust | python. Tampoco
# entra en el hash: el crate es una transliteración que produce layouts idénticos
# byte a byte, así que una caja sin wheel reproduce la geometría y sirve el mismo
# cache. OJO: pedir "rust" sin wheel NO falla, cae a Python — el arranque avisa.
OPT_ENGINE_BACKEND=auto
# Segundos a partir de los cuales una optimización se loguea en WARNING en vez de
# INFO. En producción LOG_LEVEL=WARNING, así que esto es lo que hace visible la
# cola lenta sin subir el nivel de todo lo demás. 0 desactiva la promoción.
OPT_SLOW_LOG_SECONDS=10

# Pre-orders (mutable quote): seeds the "preorders" section of settings.
# At runtime the source of truth is the settings table (PATCH /settings/preorders).
PREORDER_VALIDITY_DAYS=15
MAX_OPEN_PREORDERS_PER_CLIENT=5

# Maderable frontend: base for the client review link.
# The dashboard uses HashRouter, so the base must end in "/#" for
# {FRONTEND_BASE_URL}/review/{token} to resolve to the SPA route.
FRONTEND_BASE_URL=http://localhost:3000

# Edge banding: waste applied over the net length before rounding to the billed meter
EDGE_BANDING_WASTE_FACTOR=0.10

# Sales tax (0.15 = 15%). Catalog prices are stored NET — the vendor's inventory
# publishes them that way and the documents show "Subtotal / IVA / Total" — so
# this is what turns a quote's subtotal into its total. Only SEEDS the settings
# singleton on its first read; at runtime the source of truth is the settings
# table (PATCH /settings/taxes), because the rate changes by law. Every order
# freezes the rate it was billed at.
TAX_RATE=0.15

# Order attachments (anexos): PDFs/screenshots stored on local disk. In Docker
# this points at a mounted volume (/src/uploads); locally it defaults to ./uploads.
ATTACHMENTS_DIR=/src/uploads
MAX_ATTACHMENT_MB=10

# Print agent (silent label/consolidated printing). Payloads (TSPL labels,
# consolidated PDFs) are rendered server-side and spooled to local disk, one
# subfolder per branch; only the PrintJob row (metadata + status) lives in
# Postgres. In Docker PRINT_SPOOL_DIR points at a mounted volume (/src/print_spool);
# locally it defaults to ./print_spool. Every value below has a safe default --
# override only if needed.
PRINT_SPOOL_DIR=/src/print_spool
# A job no agent claims within the TTL expires (the shop PC was off).
PRINT_JOB_TTL_MINUTES=10
# A claimed ('sent') job with no ack within this window is re-queued (at-least-once).
PRINT_JOB_VISIBILITY_TIMEOUT_SECONDS=60
# How long GET /print/jobs/next holds the long-poll before returning 204.
PRINT_POLL_WAIT_SECONDS=25
# Spool disk hygiene: an mtime backstop reclaims files older than the retention
# window (catches CASCADE-orphaned files and any leftover backlog), throttled to
# once per interval. Keep RETENTION >= PRINT_JOB_TTL_MINUTES.
PRINT_SPOOL_RETENTION_MINUTES=60
PRINT_SPOOL_SWEEP_INTERVAL_MINUTES=5
# Thermal label geometry (3nStar LTT334). Match the physical roll; flip INVERT if
# a given unit prints inverted.
PRINT_LABEL_WIDTH_MM=100
PRINT_LABEL_HEIGHT_MM=50
PRINT_LABEL_GAP_MM=2
PRINT_LABEL_DPI=203
PRINT_LABEL_INVERT=false

# Authentication (JWT). SECRET_KEY signs the tokens: MANDATORY in production;
# falls back to a development placeholder in local/staging. The access token is
# short-lived (ACCESS_TOKEN_EXPIRE_MINUTES) and renewed via the refresh token,
# whose validity is REFRESH_TOKEN_EXPIRE_DAYS. Kept at 1 day: the frontend forces
# a real login once per calendar day (attendance is recorded on /auth/login, not
# on refresh), so a longer window only matters for abandoned sessions. See
# docs/AUTH.md.
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1

# First administrator: idempotent seed applied by scripts/seed_admin.py
# (run `make seed-admin`), NOT by a migration. If both are set and no user
# exists with that email, the script creates it with the "administrador" role.
# Empty = nothing is seeded.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=cambia-esta-clave

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://cutter:cutter@postgres:5432/cutter_db

# External (SIFAC) MySQL: read-only source of BOTH syncs — the product catalog
# (POST /products/sync, table `marticulo`) and the client list
# (POST /clients/sync, table `mcliente`). One server, one credential; the name
# is catalog-era. The source tables are latin1, so keep ?charset=latin1 or
# accents come back mangled. Use a READ-ONLY user: this system never writes to
# it. Leave empty to disable both sync endpoints.
EXTERNAL_CATALOG_URL=
EXTERNAL_CATALOG_CONNECT_TIMEOUT_SECONDS=10
EXTERNAL_CATALOG_READ_TIMEOUT_SECONDS=30

# Company data (shown on the proforma PDF)
COMPANY_NAME=Mi Empresa
COMPANY_TAGLINE=eslogan de la empresa
COMPANY_EMAIL=correo@empresa.com
COMPANY_PHONE=0990000000 / 0990000001
# Branches as single-line JSON (commas in the address are fine)
COMPANY_BRANCHES=[{"name":"Sucursal 1","address":"Calle Principal y Secundaria"},{"name":"Sucursal 2","address":"Av. Central y Transversal"}]